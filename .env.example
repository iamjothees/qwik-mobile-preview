# ==============================================================
# Qwik Mobile Preview - Environment Configuration Template
# Copy this file to .env for local development or production.
# ==============================================================

# --- System & Timezone ---
TZ=Asia/Kolkata
NODE_ENV=production

# --- Relay Server Network Settings ---
PORT=4567
HOST=0.0.0.0

# Detected Host LAN IP (e.g., 192.168.29.10) for localhost URL conversion.
# Leave blank to let the server auto-detect on startup.
HOST_IP=

# Public domain and URL if serving behind a reverse proxy or Cloudflare tunnel
PUBLIC_DOMAIN=preview.local
PUBLIC_URL=http://localhost:4567/

# --- Optional Security & Access Control ---
# Secret auth key to restrict who can push tabs to your relay server.
# Leave empty for open / multi-tenant pairing key mode.
AUTH_KEY=

# --- Watchtower Auto-Updater (Production) ---
# Optional shoutrrr URL to receive Discord/Slack/Telegram webhook alerts on new image pulls
WATCHTOWER_WEBHOOK_URL=
