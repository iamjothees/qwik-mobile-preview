# Copy to `.env` on the SERVER (next to docker-compose.prod.yml). Never commit the real file.
# It is used for docker-compose.prod.yml variable substitution.

# --- System & Timezone ---
TZ=Asia/Kolkata
NODE_ENV=production

# --- Relay Server Network Settings ---
PORT=4567
HOST=0.0.0.0

# Host LAN IP override (optional on server; Cloudflare tunnel or reverse proxy handles external traffic)
HOST_IP=

# Public domain and URL for joecodes.in ecosystem
PUBLIC_DOMAIN=qwik-preview.joecodes.in
PUBLIC_URL=https://qwik-preview.joecodes.in/

# --- Optional Security & Access Control ---
# Leave empty for public multi-tenant pairing key mode, or set a secret string to lock down the hub
AUTH_KEY=

# --- Watchtower Deployment Alerts ---
# Optional shoutrrr webhook URL to receive notifications when watchtower updates the container
WATCHTOWER_WEBHOOK_URL=
